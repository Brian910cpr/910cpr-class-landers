{
  "name": "910cpr-checkout-confirmation",
  "main": "checkout-confirmation.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "triggers": {"crons": ["* * * * *"]},
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["registration@notify.910cpr.com"]}],
  "vars": {
