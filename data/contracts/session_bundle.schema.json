{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://910cpr.com/schemas/session-bundle-1.0.0.json",
  "title": "LanderWare Session Bundle",
  "description": "Vendor-neutral export of canonical durable objects and their provenance. The bundle is not itself authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "generated_at", "purpose", "scope", "identity_aliases", "organizations", "people", "instructors", "instructor_assignments", "sessions", "registrations", "requirements", "documents", "communications", "billing", "inventory", "provenance", "conflicts", "missing_dependencies"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^bnd_[a-f0-9]{20}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string"},
    "scope": {"type": "object", "required": ["date", "timezone"], "properties": {"date": {"type": "string", "format": "date"}, "timezone": {"type": "string"}}, "additionalProperties": false},
    "identity_aliases": {"type": "array", "items": {"$ref": "#/$defs/identityAlias"}},
    "organizations": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "people": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "instructors": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "instructor_assignments": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
    "registrations": {"type": "array", "items": {"$ref": "#/$defs/registration"}},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "documents": {"type": "array", "items": {"type": "object"}},
    "communications": {"type": "array", "items": {"type": "object"}},
    "billing": {"type": "array", "items": {"type": "object"}},
    "inventory": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "array", "items": {"type": "object", "required": ["provenance_id", "source_system", "source_id", "facts"]}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "missing_dependencies": {"type": "array", "items": {"type": "object", "required": ["code", "affects", "detail"]}}
  },
  "$defs": {
    "sourceRef": {"type": "object", "additionalProperties": false, "required": ["source_system", "source_id"], "properties": {"source_system": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}}},
    "identityAlias": {"type": "object", "additionalProperties": false, "required": ["entity_kind", "canonical_entity_id", "source_refs"], "properties": {"entity_kind": {"enum": ["person", "organization", "location", "course"]}, "canonical_entity_id": {"type": "string", "minLength": 1}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}}},
    "identified": {"type": "object", "minProperties": 1},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "source_refs", "course", "organization_id", "location", "start_at", "end_at", "timezone", "status", "occupancy", "instructor_assignment_ids", "registration_ids"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^ses_[a-f0-9]{20}$"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
        "course": {"type": ["object", "null"]},
        "organization_id": {"type": ["string", "null"]},
        "location": {"type": ["object", "null"]},
        "start_at": {"type": "string", "format": "date-time"},
        "end_at": {"type": ["string", "null"], "format": "date-time"},
        "timezone": {"type": "string"},
        "status": {"enum": ["draft", "scheduled", "committed", "active", "completed", "cancelled", "unknown"]},
        "occupancy": {"type": "object", "additionalProperties": false, "required": ["reserves_customer_availability", "blocking_resource_ids", "reason"], "properties": {"reserves_customer_availability": {"type": "boolean"}, "blocking_resource_ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}},
        "instructor_assignment_ids": {"type": "array", "items": {"type": "string"}},
        "registration_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration_id", "session_id", "person_id", "status", "source_refs"],
      "properties": {
        "registration_id": {"type": "string", "pattern": "^reg_[a-f0-9]{20}$"},
        "session_id": {"type": "string", "pattern": "^ses_[a-f0-9]{20}$"},
        "person_id": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
      }
    }
  }
}
